# Local development. Start Redis, PostgreSQL, and Prometheus with: make infra
# For self-hosted installation, run scripts/install.sh instead; it creates .env.installation.
SPOOL_ADDR=127.0.0.1:8088
REDIS_URL=redis://127.0.0.1:6388/0
DATABASE_URL=postgres://spool:spool-local@127.0.0.1:5448/spool?sslmode=disable
PROMETHEUS_URL=http://127.0.0.1:9098
SPOOL_ENV=development
SPOOL_STATIC_DIR=apps/web/dist
SPOOL_READ_ONLY=false
# Accounts are required when SPOOL_ADDR is not a loopback address.
# Set SPOOL_SECURE_COOKIE=true when serving over HTTPS.
SPOOL_ADMIN_USER=
SPOOL_ADMIN_PASSWORD=
SPOOL_VIEWER_USER=
SPOOL_VIEWER_PASSWORD=
SPOOL_SESSION_KEY=
SPOOL_SECURE_COOKIE=false

# Safe public instance metadata; displayed before sign-in.
SPOOL_INSTANCE_NAME=
SPOOL_DEPLOYMENT_MODE=self-hosted
SPOOL_SUPPORT_URL=
# Match the Prometheus scrape job for this deployment.
SPOOL_METRICS_JOB=spool

# Persistent user management and multiple organizations. New installer/hosted
# preparations enable this automatically; manual legacy setups default false.
SPOOL_MULTI_ORG=false
SPOOL_ORGANIZATION_NAME=My organization
# Generate independent secrets (openssl rand -hex 32), and preserve DATA_KEY.
SPOOL_DATA_KEY=
SPOOL_SETUP_TOKEN=
# Browser setup: enable MULTI_ORG, set DATA_KEY/SETUP_TOKEN/SESSION_KEY,
# and leave ADMIN_USER/ADMIN_PASSWORD empty. See docs/organizations.md.

# Required in organization mode; configure external Prometheus with the same token.
SPOOL_METRICS_TOKEN=
