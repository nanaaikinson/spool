# Local development. Start Redis, PostgreSQL, and Prometheus with: make infra
# For self-hosted installation, run scripts/install.sh instead; it creates .env.installation.
SPOOL_ADDR=127.0.0.1:8088
REDIS_URL=redis://127.0.0.1:6388/0
DATABASE_URL=postgres://spool:spool-local@127.0.0.1:5448/spool?sslmode=disable
PROMETHEUS_URL=http://127.0.0.1:9098
SPOOL_ENV=development
SPOOL_STATIC_DIR=apps/web/dist
SPOOL_READ_ONLY=false
# Accounts are required when SPOOL_ADDR is not a loopback address.
# Set SPOOL_SECURE_COOKIE=true when serving over HTTPS.
SPOOL_ADMIN_USER=
SPOOL_ADMIN_PASSWORD=
SPOOL_VIEWER_USER=
SPOOL_VIEWER_PASSWORD=
SPOOL_SESSION_KEY=
SPOOL_SECURE_COOKIE=false
