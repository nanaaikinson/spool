# Copy to .env.production for compose.production.external.yaml or docker run.
# On Dokploy/Coolify, enter these values in the resource's Environment UI.
# Point at the SAME Redis instance and DB index used by your Asynq workers.
# Redis with ACL + TLS: rediss://USERNAME:URL_ENCODED_PASSWORD@HOST:PORT/DB
# Redis password only: redis://:URL_ENCODED_PASSWORD@HOST:PORT/DB
# Sentinel: redis-sentinel://:URL_ENCODED_PASSWORD@SENTINEL1:26379,SENTINEL2:26379/DB?master=NAME
REDIS_URL=
# Optional, for rediss:// or Sentinel with a private CA or mutual TLS. Mount the
# files into the container and give their paths here.
# REDIS_TLS_CA_FILE=/run/secrets/redis-ca.pem
# REDIS_TLS_CERT_FILE=/run/secrets/redis-client.pem
# REDIS_TLS_KEY_FILE=/run/secrets/redis-client-key.pem
# Example: postgres://spool:URL_ENCODED_PASSWORD@HOST:5432/spool?sslmode=verify-full
# Create the database first; Spool automatically creates its tables at startup.
DATABASE_URL=

SPOOL_ADDR=0.0.0.0:8080
SPOOL_ENV=production
SPOOL_ADMIN_USER=admin
# Generate separate values with: openssl rand -hex 32
SPOOL_ADMIN_PASSWORD=
SPOOL_SESSION_KEY=
SPOOL_SECURE_COOKIE=true
SPOOL_READ_ONLY=false

# Optional: configure both viewer fields together, or leave both empty.
SPOOL_VIEWER_USER=
SPOOL_VIEWER_PASSWORD=
# Optional: historical charts require Prometheus scraping this app's /metrics.
PROMETHEUS_URL=
