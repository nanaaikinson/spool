# Copy to .env.production for compose.production.external.yaml or docker run.
# For guided setup on your Docker host, run scripts/install.sh; it creates .env.installation.
# Keep values unquoted when sharing this file with docker run --env-file.
# On Dokploy/Coolify, enter these values in the resource's Environment UI.
# Point at the SAME Redis instance and DB index used by your Asynq workers.
# Redis with ACL + TLS: rediss://USERNAME:URL_ENCODED_PASSWORD@HOST:PORT/DB
# Redis password only: redis://:URL_ENCODED_PASSWORD@HOST:PORT/DB
# Sentinel: redis-sentinel://:URL_ENCODED_PASSWORD@SENTINEL1:26379,SENTINEL2:26379/DB?master=NAME
REDIS_URL=
# Optional, for rediss:// or Sentinel with a private CA or mutual TLS. Mount the
# files into the container and give their paths here.
# For Compose, also add REDIS_TLS_* variables to app.environment in a custom override.
# REDIS_TLS_CA_FILE=/run/secrets/redis-ca.pem
# REDIS_TLS_CERT_FILE=/run/secrets/redis-client.pem
# REDIS_TLS_KEY_FILE=/run/secrets/redis-client-key.pem
# Example: postgres://spool:URL_ENCODED_PASSWORD@HOST:5432/spool?sslmode=verify-full
# Create the database first; Spool automatically creates its tables at startup.
DATABASE_URL=

SPOOL_ADDR=0.0.0.0:8080
SPOOL_ENV=production
SPOOL_ADMIN_USER=admin
# Generate separate values with: openssl rand -hex 32
SPOOL_ADMIN_PASSWORD=
SPOOL_SESSION_KEY=
SPOOL_SECURE_COOKIE=true
SPOOL_READ_ONLY=false

# Optional: configure both viewer fields together, or leave both empty.
SPOOL_VIEWER_USER=
SPOOL_VIEWER_PASSWORD=
# External Prometheus URL. Historical charts require scraping this app's /metrics.
# To bundle it with Compose, add -f compose.production.prometheus.yaml;
# that override sets PROMETHEUS_URL and retains 15 days of metrics privately.
PROMETHEUS_URL=

# Safe public instance metadata; displayed before sign-in.
SPOOL_INSTANCE_NAME=
SPOOL_DEPLOYMENT_MODE=self-hosted
SPOOL_SUPPORT_URL=
# Match the Prometheus scrape job for this deployment.
SPOOL_METRICS_JOB=spool

# Persistent user management and multiple organizations. New installer/hosted
# preparations enable this automatically; manual legacy setups default false.
SPOOL_MULTI_ORG=false
SPOOL_ORGANIZATION_NAME=My organization
# Generate independent secrets (openssl rand -hex 32), and preserve DATA_KEY.
SPOOL_DATA_KEY=
SPOOL_SETUP_TOKEN=
# Browser setup: enable MULTI_ORG, set DATA_KEY/SETUP_TOKEN/SESSION_KEY,
# and leave ADMIN_USER/ADMIN_PASSWORD empty. See docs/organizations.md.

# Required in organization mode; configure external Prometheus with the same token.
SPOOL_METRICS_TOKEN=
