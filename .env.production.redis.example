# Copy to .env.production for compose.production.redis.yaml.
# On Dokploy/Coolify, enter these values in the resource's Environment UI.
# Point at the SAME Redis instance and DB index used by your Asynq workers.
# Redis with ACL + TLS: rediss://USERNAME:URL_ENCODED_PASSWORD@HOST:PORT/DB
# Redis password only: redis://:URL_ENCODED_PASSWORD@HOST:PORT/DB
REDIS_URL=

# Generate a URL-safe password with: openssl rand -hex 32
# This password is also interpolated into the app's PostgreSQL connection URI.
POSTGRES_PASSWORD=

SPOOL_ADDR=0.0.0.0:8080
SPOOL_ENV=production
SPOOL_ADMIN_USER=admin
# Generate separate values for the password and signing key.
SPOOL_ADMIN_PASSWORD=
SPOOL_SESSION_KEY=
SPOOL_SECURE_COOKIE=true
SPOOL_READ_ONLY=false

# Optional: configure both viewer fields together, or leave both empty.
SPOOL_VIEWER_USER=
SPOOL_VIEWER_PASSWORD=
# Optional: historical charts require Prometheus scraping this app's /metrics.
PROMETHEUS_URL=
