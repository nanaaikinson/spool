# Disposable local organization/RBAC testing. These are public development secrets.
# Copy to .env.rbac and use: docker compose --env-file .env.rbac up -d --build --wait
COMPOSE_FILE=compose.production.redis.yaml:compose.production.prometheus.yaml:compose.production.host.yaml:compose.rbac.yaml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROJECT_NAME=spool-rbac
SPOOL_HOST_PORT=8098
REDIS_URL=redis://redis-alpha:6379/0
POSTGRES_PASSWORD=local-rbac-postgres-password
SPOOL_MULTI_ORG=true
SPOOL_ORGANIZATION_NAME=Alpha
SPOOL_DATA_KEY=local-rbac-data-encryption-key-12345678901234567890
SPOOL_METRICS_TOKEN=local-rbac-metrics-scrape-token-12345678901234567890
SPOOL_SETUP_TOKEN=local-rbac-first-setup-token-12345678901234567890
SPOOL_ADMIN_USER=admin
SPOOL_ADMIN_PASSWORD=local-admin-password
SPOOL_SESSION_KEY=local-rbac-session-signing-key-12345678901234567890
SPOOL_VIEWER_USER=
SPOOL_VIEWER_PASSWORD=
SPOOL_READ_ONLY=false
SPOOL_SECURE_COOKIE=false
